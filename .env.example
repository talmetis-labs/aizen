# Copy to `.env` and fill in. `.env` is gitignored — never commit real tokens.
#
#   cp .env.example .env
#
# Every var below is read by the binary itself (see `cli_config::branded_env`): the `AIZEN_`-prefixed
# name wins over the unprefixed one, and both win over `~/.aizen/cli-config.json`. That's what makes a
# container configurable with no interactive `aizen config` — the setup wizards need a TTY, which a
# container doesn't have.

# ── model endpoint (required) ──────────────────────────────────────────────────────────
# Any OpenAI-compatible base. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://api.anthropic.com/v1     (Anthropic serves an OpenAI-compatible surface)
#   http://host.docker.internal:8080/v1   (a local llama.cpp/vLLM — needs AIZEN_ALLOW_PRIVATE_NET=1)
AIZEN_BASE_URL=https://api.openai.com/v1
AIZEN_API_KEY=
AIZEN_MODEL=

# ── the bot (required for `serve`) ─────────────────────────────────────────────────────
# From @BotFather. On first run with no owner yet, the daemon prints a PAIRING CODE to its logs
# (`docker compose logs -f`); send that code to the bot from your account to claim ownership. The
# resulting chat id is written into the volume, so you only do this once.
AIZEN_TELEGRAM_TOKEN=

# Discord instead of Telegram: set this, then run the container with `command: ["discord","serve"]`.
# AIZEN_DISCORD_BOT_TOKEN=

# ── optional ──────────────────────────────────────────────────────────────────────────
# Web search is KEYED-ONLY — with no key, `web_search` returns "add a key" rather than degrading.
# AIZEN_TAVILY_API_KEY=
# AIZEN_JINA_API_KEY=
# Raises GitHub API limits to 5000 req/h for the reach layer.
# AIZEN_GITHUB_TOKEN=
